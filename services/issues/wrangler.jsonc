{
    "$schema": "node_modules/wrangler/config-schema.json",
    // issues.ariapis.com: the app's Report an Issue posts to /v1/issues, and
    // /dashboard lists them behind the Cloudflare Access application
    // "issues dashboard" (README.md). The worker runs before every asset, so
    // the dashboard's page is checked against Access like its API.
    "name": "issues",
    "main": "src/worker/index.ts",
    "account_id": "355f97d9a981bff4cd52aa362ae577c7",
    "compatibility_date": "2026-10-01",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "issues.ariapis.com", "custom_domain": true }],
    "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "none"
    },
    "vars": {
        "ACCESS_TEAM_DOMAIN": "mileniumhq.cloudflareaccess.com",
        "ACCESS_AUD": "988b88dc0e1cd590d2b8a5ffcf3d5c1f7c9ffc8cb1a3b45e1068d334433c473d"
    },
    "ratelimits": [{ "name": "SUBMIT_LIMIT", "namespace_id": "1281931", "simple": { "limit": 5, "period": 60 } }],
    "durable_objects": { "bindings": [{ "name": "ISSUES", "class_name": "IssueStore" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IssueStore"] }],
    // what people type stays out of request traces
    "observability": { "enabled": false }
}
