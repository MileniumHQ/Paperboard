{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types", "bun"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/shared.ts", "src/worker/**/*.ts", "test/**/*.ts"]
}
