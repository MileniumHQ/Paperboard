{
  "name": "paperboard-monorepo",
  "private": true,
  "version": "0.4.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "apps/origami/library",
    "packages/*",
    "panels/*"
  ],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "setup": "bun scripts/dev.ts setup",
    "build:panels": "bun scripts/dev.ts build",
    "build:libs": "bun scripts/dev.ts libs",
    "link:panels": "bun scripts/dev.ts link",
    "unlink:panels": "bun scripts/dev.ts unlink",
    "panels:status": "bun scripts/dev.ts status",
    "publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "1.4.4",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "resedit": "^3.1.0",
    "tar": "^7.5.22"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
  }
}
