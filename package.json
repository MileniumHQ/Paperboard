{
  "name": "paperboard-monorepo",
  "private": true,
  "version": "0.4.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "panels/*",
    "services/*"
  ],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "setup": "bun scripts/dev.ts setup",
    "build:panels": "bun scripts/dev.ts build",
    "build:libs": "bun scripts/dev.ts libs",
    "link:panels": "bun scripts/dev.ts link",
    "unlink:panels": "bun scripts/dev.ts unlink",
    "panels:status": "bun scripts/dev.ts status",
    "publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/bun": "1.4.4",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "resedit": "^3.1.1",
    "tar": "^7.5.23"
  },
  "overrides": {
    "guarded-fetch": "0.3.0"
  }
}
