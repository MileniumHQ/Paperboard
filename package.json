{
  "name": "paperboard-monorepo",
  "private": true,
  "version": "3.0.0-alpha",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*", "panels/*"],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "setup": "bun scripts/dev.ts setup",
