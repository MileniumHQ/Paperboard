{
  "name": "paperboard-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "apps/origami/library",
    "packages/*",
    "panels/*"
  ],
  "scripts": {
    "gate": "bash scripts/gate.sh",
    "setup": "bun scripts/dev.ts setup",
    "build:panels": "bun scripts/dev.ts build",
    "link:panels": "bun scripts/dev.ts link",
    "unlink:panels": "bun scripts/dev.ts unlink",
    "panels:status": "bun scripts/dev.ts status",
    "usb": "bun scripts/publish.ts usb",
    "publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "adm-zip": "^0.6.0",
    "cli-progress": "^3.12.0",
    "resedit": "^3.1.0",
    "tar": "^7.5.22"
  },
  "patchedDependencies": {
    "@solid-primitives/refs@1.1.4": "patches/@solid-primitives%2Frefs@1.1.4.patch",
    "@solid-primitives/transition-group@1.1.2": "patches/@solid-primitives%2Ftransition-group@1.1.2.patch"
  }
}
