{
  "name": "paperdocs",
  "private": true,
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "build": "tsc -b && vite build -c vite.site.client.config.ts && vite build -c vite.site.config.ts && bun scripts/prerender-site.mjs && node scripts/check-marketing-artifacts.mjs",
    "test": "bun test",
    "deploy": "bun run build && wrangler deploy",
    "test:browser": "node scripts/check-learn-browser.mjs",
    "screenshots:demo": "node scripts/capture-demo.mjs",
    "screenshots:actions": "bun scripts/capture-integrations.ts"
  },
  "dependencies": {
    "@mileniumhq/paperui": "workspace:*",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.61.1",
    "sharp": "0.33.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.147.0"
  }
}
