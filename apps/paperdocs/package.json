{
  "name": "paperdocs",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "build": "node scripts/check-prose-spacing.mjs && tsc -b && vite build -c vite.site.client.config.ts && vite build -c vite.site.elements.config.ts && vite build -c vite.site.config.ts && bun scripts/prerender-site.mjs && node scripts/check-marketing-artifacts.mjs",
    "test": "bun test",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "deploy": "bun run build && wrangler deploy",
    "test:browser": "node scripts/check-learn-browser.mjs",
    "renders": "node scripts/render-models.mjs",
    "screens": "node scripts/store-screens.mjs"
  },
  "dependencies": {
    "@mileniumhq/paperui": "workspace:*",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@mileniumhq/paperapi": "workspace:*",
    "@types/node": "^24.19.2",
    "node-html-parser": "^9.0.7",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "wrangler": "^4.164.0"
  }
}
