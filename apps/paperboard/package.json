{
  "name": "paperboard",
  "productName": "Paperboard",
  "version": "1.0.0-alpha",
  "description": "Run and manage tools locally.",
  "main": "./out/main/index.js",
  "author": "Milenium <contact@paperboard.dev>",
  "homepage": "https://paperboard.dev",
  "license": "PolyForm-Strict-1.0.0",
  "keywords": [
    "paperboard",
    "self-hosting",
    "tools"
  ],
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "rm -rf node_modules/@paperboard-dev/paperapi node_modules/@paperboard-dev/paperui && mkdir -p node_modules/@paperboard-dev && ln -sfn ../../../PaperAPI node_modules/@paperboard-dev/paperapi && ln -sfn ../../../PaperUI node_modules/@paperboard-dev/paperui",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@paperboard-dev/paperapi": "file:../PaperAPI",
    "@paperboard-dev/paperui": "file:../PaperUI",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "tar": "^7.5.22",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "solid-js": "^1.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-solid": "^2.11.10"
  }
}