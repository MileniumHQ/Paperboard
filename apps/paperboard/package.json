{
  "name": "paperboard",
  "productName": "Paperboard",
  "version": "3.0.0-alpha",
  "description": "Run and manage tools locally.",
  "main": "./out/main/index.js",
  "author": "Milenium <contact@paperboard.dev>",
  "homepage": "https://paperboard.dev",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "paperboard",
    "self-hosting",
    "tools"
  ],
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun test",
    "gates": "bun run typecheck && bun test && bunx biome lint && bash scripts/check-no-silent-catches.sh",
    "start": "bun scripts/launch.ts preview",
    "dev": "bun scripts/launch.ts dev",
    "dev:browser": "bun scripts/launch.ts dev -- --browser",
    "build": "bun run typecheck && electron-vite build",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:mac-x64": "bun run build && electron-builder --mac --x64",
    "build:mac-arm64": "bun run build && electron-builder --mac --arm64",
    "build:linux": "bun run build && electron-builder --linux AppImage --x64",
    "build:linux-arm64": "bun run build && electron-builder --linux AppImage --arm64",
    "usb": "bun devutils/publish.ts usb",
    "publish": "bun devutils/publish.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@paperboard-dev/paperapi": "workspace:*",
    "@paperboard-dev/paperui": "workspace:*",
    "adm-zip": "^0.6.0",
    "bonjour-service": "^1.4.4",
    "commander": "^15.0.0",
    "electron-updater": "^6.8.9",
    "mime-types": "^3.0.2",
    "node-pty": "1.2.0-beta.14",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@clack/prompts": "^1.8.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/commander": "^2.12.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.1",
    "@types/semver": "^7.8.0",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "cli-progress": "^3.12.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "solid-js": "^1.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-solid": "^2.11.10"
  }
}