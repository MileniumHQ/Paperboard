{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "origami",
    "main": "src/index.ts",
    "account_id": "355f97d9a981bff4cd52aa362ae577c7",
    "compatibility_date": "2026-08-18",
    "routes": [
        {
            "pattern": "origami.ariapis.com",
            "custom_domain": true
        },
        {
            "pattern": "i.paperboard.dev",
            "custom_domain": true
        }
    ],
    // The panel library division: built by `bun run build:library` into
    // library/dist and served from the same origin as the registry it
    // reads. Registry routes never match an asset, so the worker keeps
    // serving them; unmatched paths fall through to the worker's 404.
    "assets": {
        "directory": "./library/dist",
        "not_found_handling": "none",
        "run_worker_first": false
    },
    "kv_namespaces": [
        {
            "binding": "PACKAGES",
            "id": "89764cd39f114ba18e25945504982bf0"
        }
    ],
    "r2_buckets": [
        {
            "binding": "PANELS_BUCKET",
            "bucket_name": "paperboard-boards"
        },
        {
            "binding": "PAPERDL_BUCKET",
            "bucket_name": "paperboard-paperdl"
        }
    ],
    "vars": {
        // canonical public origin for record URLs. Derived-at-publish
        // request origins are a Host-header poisoning vector (O10): the
        // stored downloadUrl/iconUrl must come from configuration, not
        // from whoever sent the publish request.
        "PANEL_BASE_URL": "https://origami.ariapis.com"
    },
    "observability": {
        "enabled": true
    }
}
