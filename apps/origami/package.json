{
    "name": "origami",
    "version": "0.4.0",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "scripts": {
        "build:library": "bun run --cwd library build",
        "dev": "bun run build:library && wrangler dev",
        "deploy": "bun run build:library && wrangler deploy -c wrangler.jsonc --no-autoconfig",
        "types": "wrangler types",
        "typecheck": "tsc --noEmit && bun run --cwd library typecheck",
        "test": "bun test ./test",
        "test:library": "bun run --cwd library test",
        "update:java": "bun scripts/update-java.ts",
        "update:ollama": "bun scripts/update-ollama.ts",
        "update:helium": "bun scripts/update-helium.ts",
        "update:steamcmd": "bun scripts/update-steamcmd.ts",
        "update:libcurl-gnutls": "bun scripts/update-libcurl-gnutls.ts",
        "update:sourcemod": "bun scripts/update-sourcemod.ts",
        "update:windows-runtimes": "bun scripts/update-windows-runtimes.ts",
        "update:dotnet": "bun scripts/update-dotnet.ts",
        "update:proton": "bun scripts/update-proton.ts",
        "update:codex": "bun scripts/update-codex.ts",
        "update:claude-code": "bun scripts/update-claude-code.ts",
        "update:opencode": "bun scripts/update-opencode.ts"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261005.1",
        "@types/bun": "latest",
        "wrangler": "^4.147.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
