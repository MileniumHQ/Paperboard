{
    "name": "@mileniumhq/paperui",
    "version": "0.4.0",
    "type": "module",
    "main": "./dist/paperui.cjs",
    "module": "./dist/paperui.es.js",
    "types": "./dist/index.d.ts",
    "solid": "./dist/paperui.es.js",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "solid": "./dist/paperui.es.js",
            "import": "./dist/paperui.es.js",
            "require": "./dist/paperui.cjs"
        },
        "./headless": {
            "types": "./dist/headless.d.ts",
            "solid": "./dist/headless.es.js",
            "import": "./dist/headless.es.js",
            "require": "./dist/headless.cjs"
        },
        "./marketing": {
            "types": "./dist/marketing.d.ts",
            "solid": "./dist/marketing.es.js",
            "import": "./dist/marketing.es.js",
            "require": "./dist/marketing.cjs"
        },
        "./style.css": "./dist/paperui.css",
        "./marketing/elements": {
            "types": "./dist/marketing-elements.d.ts",
            "import": "./dist/marketing-elements.es.js",
            "require": "./dist/marketing-elements.cjs"
        },
        "./marketing.css": "./dist/marketing.css",
        "./panel.css": "./dist/panel.css",
        "./tokens.css": "./dist/tokens.css",
        "./colors.css": "./dist/colors.css",
        "./fonts/NunitoSans.woff2": "./dist/NunitoSans.woff2",
        "./LICENSE": "./LICENSE",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc --noEmit && vite build && vite build -c vite.marketing.config.ts && cp src/styles/panel.css src/styles/colors.css dist/ && sed '/^@import /d' src/styles/styles.css > dist/tokens.css",
        "test": "bash scripts/check-styling.sh && vitest run"
    },
    "devDependencies": {
        "@solidjs/testing-library": "^0.8.10",
        "@types/node": "^24.19.2",
        "@types/prismjs": "^1.26.6",
        "@types/three": "^0.187.0",
        "jsdom": "^31.0.1",
        "pdfjs-dist": "6.5.438",
        "solid-js": "^1.9.19",
        "testkit": "workspace:*",
        "three": "0.187.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^5.1.2",
        "vite-plugin-solid": "^2.11.16",
        "vitest": "^5.1.0"
    },
    "peerDependencies": {
        "solid-js": "^1.9.19"
    },
    "dependencies": {
        "anser": "^2.3.5",
        "marked": "^18.2.1",
        "prismjs": "^1.30.0",
        "solid-transition-group": "^0.3.0"
    },
    "description": "SolidJS component library and design system for Paperboard panels and desktop-class web apps.",
    "keywords": [
        "solidjs",
        "solid",
        "components",
        "ui",
        "design-system",
        "paperboard",
        "desktop"
    ],
    "author": "Paperboard <https://paperboard.dev>",
    "homepage": "https://paperboard.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MileniumHQ/Paperboard.git",
        "directory": "packages/paperui"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
