{
    "name": "dev.paperboard.agents",
    "private": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && bun build ./src/service.ts --outdir ./dist --entry-naming [name].[ext] --chunk-naming service/[name]-[hash].[ext] --splitting --target=node --external @mileniumhq/paperui",
        "pack": "bunx paperapi pack",
        "preview": "vite preview",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "test": "bun ../../packages/testkit/src/withChrome.ts bun test --parallel"
    },
    "dependencies": {
        "@mileniumhq/paperapi": "workspace:*",
        "@mileniumhq/paperui": "workspace:*",
        "esbuild-wasm": "0.28.2",
        "just-bash": "3.6.1",
        "semver": "^7.8.6",
        "solid-js": "^1.9.19"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/semver": "^7.8.0",
        "testkit": "workspace:*",
        "typescript": "~6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-solid": "^2.11.16"
    }
}
