{
    "name": "Game Server",
    "id": "dev.paperboard.gameserver",
    "version": "0.2.0",
    "description": "Dedicated Minecraft & game server manager",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "status",
            "name": "Server status",
            "description": "Online or offline, players and version, with a start and stop button",
            "sizes": ["2x1", "2x2"]
        },
        {
            "id": "players",
            "name": "Players online",
            "description": "Who is playing right now",
            "sizes": ["2x2"]
        },
        {
            "id": "console",
            "name": "Console",
            "description": "The server log's latest lines, errors marked",
            "sizes": ["4x1"]
        },
        {
            "id": "motd",
            "name": "Server list message",
            "description": "The MOTD as players see it in their server list",
            "sizes": ["4x1"]
        }
    ],
    "tutorial": [
        {"icon": "dns", "title": "No terminal needed", "body": "Paperboard downloads the server and the software it needs. Pick a Minecraft version and play."},
        {"icon": "extension", "title": "Plugins by name", "body": "Search for a plugin to install it, and update them all to their latest version in one click."},
        {"icon": "swap_horiz", "title": "Switch loaders any time", "body": "Paper, Fabric, NeoForge and Forge are all supported, and you can switch between them whenever you like."},
        {"icon": "backup", "title": "Backups that keep worlds safe", "body": "Back up to this computer, Google Drive or S3. A running server pauses saving during the copy so the world isn't torn."}
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Overview"
            },
            {
