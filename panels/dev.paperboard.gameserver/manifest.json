{
    "name": "Game Server",
    "id": "dev.paperboard.gameserver",
    "version": "0.1.1",
    "description": "Dedicated Minecraft & game server manager",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "status",
            "name": "Server status",
            "description": "Online or offline, players and version, with a start and stop button",
            "sizes": ["2x1", "2x2"]
        },
        {
            "id": "players",
            "name": "Players online",
            "description": "Who is playing right now",
            "sizes": ["2x2"]
        },
        {
            "id": "console",
            "name": "Console",
            "description": "The server log's latest lines, errors marked",
            "sizes": ["4x1"]
        },
        {
            "id": "motd",
            "name": "Server list message",
            "description": "The MOTD as players see it in their server list",
            "sizes": ["4x1"]
        }
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Overview"
            },
            {
                "light": "./store/2-light.png",
                "dark": "./store/2-dark.png",
                "alt": "Live world map"
            },
            {
                "light": "./store/3-light.png",
                "dark": "./store/3-dark.png",
                "alt": "Players"
            },
            {
                "light": "./store/4-light.png",
                "dark": "./store/4-dark.png",
                "alt": "Plugins and mods"
            }
        ],
        "services": [
            {
                "name": "Mojang",
                "detail": "Downloading vanilla servers and player skins"
            },
            {
                "name": "PaperMC",
                "detail": "Downloading Paper servers"
            },
            {
                "name": "Fabric",
                "detail": "Downloading the Fabric loader"
            },
            {
                "name": "NeoForged",
                "detail": "Downloading the NeoForge installer"
            },
            {
                "name": "Minecraft Forge",
                "detail": "Downloading the Forge installer"
            },
            {
                "name": "Modrinth",
                "detail": "Finding plugins and mods"
            }
        ],
        "credits": [
            {
                "name": "prismarine-nbt",
                "detail": "Reading world data"
            }
        ],
        "requirements": [
            {
                "name": "Storage",
                "detail": "4 GB"
            },
            {
                "name": "RAM",
                "detail": "8 GB"
            },
            {
                "name": "CPU",
                "detail": "4 cores"
            }
        ]
    }
}
