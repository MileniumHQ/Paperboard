{
    "name": "Game Server",
    "id": "dev.paperboard.gameserver",
    "version": "0.3.0",
    "description": "Host and manage dedicated servers for your games",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "status",
            "name": "Server status",
            "description": "Online or offline, players and version, with a start and stop button",
            "sizes": ["2x1", "2x2"],
            "options": [{ "id": "server", "label": "Server" }]
        },
        {
            "id": "players",
            "name": "Players online",
            "description": "Who is playing right now",
            "sizes": ["2x2"],
            "options": [{ "id": "server", "label": "Server" }]
        },
        {
            "id": "console",
            "name": "Console",
            "description": "The server log's latest lines, errors marked",
            "sizes": ["4x1"],
            "options": [{ "id": "server", "label": "Server" }]
        },
        {
            "id": "motd",
            "name": "Server list message",
            "description": "The MOTD as players see it in their server list",
            "sizes": ["4x1"],
            "options": [{ "id": "server", "label": "Server" }]
        }
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Servers for Minecraft, Terraria, Palworld and Team Fortress 2"
            },
            {
                "light": "./store/2-light.png",
                "dark": "./store/2-dark.png",
                "alt": "A Minecraft server's overview and live console"
            },
            {
                "light": "./store/3-light.png",
                "dark": "./store/3-dark.png",
                "alt": "Live map of a Minecraft world"
            },
            {
                "light": "./store/4-light.png",
                "dark": "./store/4-dark.png",
                "alt": "Players with their stats, whitelist and operator controls"
            },
            {
                "light": "./store/5-light.png",
                "dark": "./store/5-dark.png",
                "alt": "Plugins installed from Modrinth"
            },
            {
                "light": "./store/6-light.png",
                "dark": "./store/6-dark.png",
                "alt": "Picking Team Fortress 2 maps for the rotation"
            },
            {
                "light": "./store/7-light.png",
                "dark": "./store/7-dark.png",
                "alt": "Palworld server options"
            },
            {
                "light": "./store/8-light.png",
                "dark": "./store/8-dark.png",
                "alt": "Backups on a schedule, kept on this computer"
            }
        ],
        "services": [
            {
                "name": "Mojang",
                "detail": "Downloading vanilla Minecraft servers and player skins"
            },
            {
                "name": "PaperMC",
                "detail": "Downloading Paper servers"
            },
            {
                "name": "Fabric, NeoForged and Minecraft Forge",
                "detail": "Downloading mod loaders"
            },
            {
                "name": "Modrinth",
                "detail": "Finding plugins, mods and modpacks"
            },
            {
                "name": "GeyserMC",
                "detail": "Downloading Geyser and Floodgate, and Bedrock players' Xbox accounts and skins"
            },
            {
                "name": "Re-Logic / Terraria",
                "detail": "Verified vanilla Terraria server downloads from terraria.org"
            },
            {
                "name": "tModLoader",
                "detail": "Verified tModLoader server downloads from GitHub"
            },
            {
                "name": "Steam",
                "detail": "Downloading and updating Palworld and Team Fortress 2 servers, and Workshop items, through SteamCMD"
            },
            {
                "name": "Steam Workshop",
                "detail": "Finding tModLoader mods and Team Fortress 2 maps, through Paperboard's modscan"
            },
            {
                "name": "Team Fortress Wiki",
                "detail": "Map pictures for Team Fortress 2"
            }
        ],
        "credits": [
            {
                "name": "prismarine-nbt",
                "detail": "Reading Minecraft world data"
            },
            {
                "name": "SourceMod and Metamod:Source",
                "detail": "Plugins for Team Fortress 2 servers"
            },
            {
                "name": "Microsoft .NET",
                "detail": "The runtime tModLoader runs on"
            }
        ],
        "requirements": [
            {
                "name": "Computer",
                "detail": "Minecraft on Linux, macOS or Windows. Terraria, Palworld and Team Fortress 2 on Linux or Windows, x64"
            },
            {
                "name": "Storage",
                "detail": "4 GB, plus the server's own download"
            },
            {
                "name": "RAM",
                "detail": "8 GB, 16 GB for Palworld"
            },
            {
                "name": "CPU",
                "detail": "4 cores"
            }
        ]
    }
