{
    "name": "Bot Creator",
    "id": "dev.paperboard.botcreator",
    "version": "0.4.0",
    "description": "Create and manage interactive Discord bots",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "bot-status",
            "name": "Bot status",
            "description": "A bot's avatar, whether it is online, and how many servers it is in",
            "sizes": [
                "1x1",
                "2x1"
            ],
            "options": [
                {
                    "id": "bot",
                    "label": "Bot"
                }
            ]
        },
        {
            "id": "command-activity",
            "name": "Command activity",
            "description": "A bot's slash commands run per hour over the last day",
            "sizes": [
                "2x2"
            ],
            "options": [
                {
                    "id": "bot",
                    "label": "Bot"
                }
            ]
        }
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Several bots, each with its own token, commands and project"
            },
            {
                "light": "./store/2-light.png",
                "dark": "./store/2-dark.png",
                "alt": "A bot's health and its latest messages"
            },
            {
                "light": "./store/3-light.png",
                "dark": "./store/3-dark.png",
                "alt": "The servers a bot is in"
            },
            {
                "light": "./store/4-light.png",
                "dark": "./store/4-dark.png",
                "alt": "A server's channels and roles, finding members and sending a message"
            },
            {
                "light": "./store/5-light.png",
                "dark": "./store/5-dark.png",
                "alt": "Slash commands the bot registers with Discord"
            },
            {
                "light": "./store/6-light.png",
                "dark": "./store/6-dark.png",
                "alt": "Polls, files and scheduled events as Actions blocks in a bot's project"
            }
        ],
        "services": [
            {
                "name": "Discord",
                "detail": "Connecting your bot and its commands"
            }
        ],
        "credits": [
            {
                "name": "discord.js",
                "detail": "Providing the bot engine"
            },
            {
                "name": "discord.py",
                "detail": "Developer Portal screenshots in the setup guide (MIT)"
            }
        ]
    }
}
