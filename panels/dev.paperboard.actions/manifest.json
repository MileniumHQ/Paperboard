{
    "name": "Actions",
    "id": "dev.paperboard.actions",
    "version": "0.2.0",
    "description": "Visual automation and workflow builder",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "run-button",
            "name": "Run button",
            "description": "Runs one workflow that starts on play, and shows whether it passed",
            "sizes": [
                "1x1",
                "2x1"
            ],
            "options": [
                {
                    "id": "flow",
                    "label": "Workflow"
                }
            ]
        },
        {
            "id": "recent-runs",
            "name": "Recent runs",
            "description": "The latest workflow runs, passed or failed",
            "sizes": [
                "2x2"
            ]
        }
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Overview"
            },
            {
                "light": "./store/2-light.png",
                "dark": "./store/2-dark.png",
                "alt": "Build flows"
            },
            {
                "light": "./store/3-light.png",
                "dark": "./store/3-dark.png",
                "alt": "Automate with triggers"
            },
            {
                "light": "./store/4-light.png",
                "dark": "./store/4-dark.png",
                "alt": "Browse the action library"
            }
        ],
        "credits": [
            {
                "name": "expr-eval",
                "detail": "Evaluating flow expressions"
            }
        ]
    }
}
