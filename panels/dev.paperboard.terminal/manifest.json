{
    "name": "Terminal",
    "id": "dev.paperboard.terminal",
    "version": "0.4.0",
    "description": "Interactive shell & multi-tab terminal console",
    "publisher": "Paperboard",
    "base": "./dist/index.html",
    "service": "./dist/service.js",
    "icon": "./branding/icon.png",
    "widgets": [
        {
            "id": "pinned-command",
            "name": "Pinned command",
            "description": "Runs a saved command and shows how it last exited",
            "sizes": ["2x1"],
            "options": [{ "id": "command", "label": "Command" }]
        }
    ],
    "store": {
        "about": "./store/about.md",
        "screenshots": [
            {
                "light": "./store/1-light.png",
                "dark": "./store/1-dark.png",
                "alt": "Tabs for each job, here working in a git project"
            },
            {
                "light": "./store/2-light.png",
                "dark": "./store/2-dark.png",
                "alt": "Saved commands, one click from the tab bar"
            },
            {
                "light": "./store/3-light.png",
                "dark": "./store/3-dark.png",
                "alt": "A clean shell, ready for any command-line tool"
            }
        ],
        "credits": [
            {
                "name": "xterm.js",
                "detail": "Rendering the terminal"
            }
        ]
    }
}
